generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══ 用户表 ═══
model User {
  id           String   @id @default(cuid())
  username     String   @unique // 用户名登录
  passwordHash String // bcrypt 哈希
  name         String   @default("") // 昵称
  role         String   @default("user") // "user" | "admin"
  balanceFen   Int      @default(0) // 余额（单位：分），¥1.00 = 100分
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions  Transaction[]
  brandProfiles BrandProfile[]
  generations   GenerationRecord[]
  modelFaces    ModelFace[]
  modelFaceJobs ModelFaceGenerationJob[]
}

// ═══ 交易流水表（Ledger 模式）═══
model Transaction {
  id             String   @id @default(cuid())
  userId         String
  type           String // "recharge" | "consume" | "refund" | "bonus"
  amountFen      Int // 金额（分）：正数=入账，负数=扣费
  balanceAfter   Int // 交易后余额快照
  description    String   @default("") // 描述
  apiModel       String? // API 模型名
  projectId      Int? // 关联的项目 ID
  idempotencyKey String?  @unique // 后台任务计费事件键；普通流水为空
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// ═══ 系统配置表 ═══
model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ═══ 品牌 DNA 记忆（Phase 4A）═══
model BrandProfile {
  id        String  @id @default(cuid())
  userId    String
  name      String  @default("默认品牌") // 品牌名称
  isDefault Boolean @default(true) // 是否为用户默认品牌

  // 模特偏好
  defaultModelId  String @default("elena")
  defaultBodyType String @default("standard")
  defaultSkinTone String @default("light")

  // 视觉风格
  lightingStyle String @default("soft_studio") // 光影风格
  bgPreference  String @default("warm_cream") // 背景偏好
  colorPalette  String @default("[]") // JSON: 品牌调色板
  promptSuffix  String @default("") // 品牌专属 prompt 后缀

  // 输出偏好
  defaultModule      String @default("product") // "product" | "scene"
  defaultAspectRatio String @default("3:4") // 默认比例
  defaultEngine      String @default("gemini") // 默认生图引擎: "gemini" | "openai"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ═══ 生成记录 + 反馈（Phase 4B）═══
model GenerationRecord {
  id         String @id @default(cuid())
  userId     String
  taskId     Int? // Dexie Project.id（前端任务关联，便于反查"任务 X 为啥失败"）
  module     String @default("product") // "product" | "scene"
  shotIndex  Int? // 镜次编号（产品图）
  promptHash String // prompt 的 hash（去重统计）
  promptText String // 完整 prompt（truncated if needed）

  // 参数快照
  modelId     String?
  bodyType    String?
  skinTone    String?
  aspectRatio String  @default("3:4")
  apiModel    String  @default("")

  // 结果
  success      Boolean @default(true)
  apiLatencyMs Int     @default(0) // API 耗时（毫秒）
  errorMessage String? // 失败原因

  // 用户反馈
  rating       Int     @default(0) // -1=差, 0=未评, 1=好
  feedback     String  @default("") // 用户文字反馈
  feedbackTags String  @default("[]") // JSON: 标签 ["服装错误","光影差","构图好"]
  downloaded   Boolean @default(false) // 是否下载过

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([taskId])
  @@index([promptHash])
  @@index([rating])
  @@index([module, shotIndex])
  @@index([createdAt])
}

/// 生成结果的「交接缓冲」——不是长期存储。
///
/// 背景：原来服务端把整张 4~5MB 的图作为**一条** SSE `data:` 行推给客户端。0731 线上实测
/// 一张图传了 105 秒，期间客户端解析不出完整事件，事件看门狗误判服务端卡死并掐断连接
/// （服务端记 "client disconnected before delivery"）——图早就生成好了，是在下行路上丢的。
///
/// 现在改为：服务端写这张表 → SSE 只推一个 id（几十字节）→ 客户端用普通 HTTP GET 取图
/// （浏览器自己管重试，不经过看门狗）→ 存进 IndexedDB 后删掉这条。
/// 所以行的生命周期只有「生成完 → 客户端取走」这一小段，峰值＝在途张数，不会撑大库；
/// 断网重连后还能按 taskId 把没取走的补拉回来，根治断网丢图。
/// 遗留未取走的由 TTL 清理（见 lib/pending-image.ts）。
model PendingImage {
  id             String   @id @default(cuid())
  userId         String // 取图时校验归属，防越权
  taskId         Int // Dexie Project.id
  shotIndex      Int      @default(0)
  kind           String   @default("result") // result | anchor
  idempotencyKey String?  @unique // 已扣费结果与 run 级流水关联；锚和老客户端为空
  data           String // base64（交接用，取走即删）
  mimeType       String   @default("image/png")
  width          Int      @default(0)
  height         Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([userId, taskId])
  @@index([kind, createdAt])
  @@index([createdAt])
}

enum ModelFaceJobStatus {
  queued
  running
  completed
  failed
}

enum ModelFaceItemStatus {
  pending
  running
  succeeded
  failed
}

enum ModelFaceBillingStatus {
  uncharged
  charged
  refund_pending
  refunded
  kept
}

/// 账号级御用 AI 模特脸库。项目目前没有对象存储，原图以 quality 88 JPEG
/// 持久化；列表只读取约 256px 宽的 thumbnail，原图按 id 单独鉴权读取。
model ModelFace {
  id          String   @id @default(cuid())
  userId      String
  image       String
  thumbnail   String?
  mimeType    String   @default("image/jpeg")
  specIndex   Int
  recipeLabel String
  favorite    Boolean  @default(false)
  name        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationItem ModelFaceGenerationItem?

  @@index([userId, favorite, createdAt])
}

/// 「再出 3 张」后台任务。activeKey 在活动时等于 userId，结束后置空，借唯一约束
/// 保证一个账号同一时刻只有一个任务，避免多进程并发重复生图/扣费。
model ModelFaceGenerationJob {
  id             String             @id @default(cuid())
  userId         String
  status         ModelFaceJobStatus @default(queued)
  activeKey      String?            @unique
  requestedCount Int
  completedCount Int                @default(0)
  failedCount    Int                @default(0)
  startSpecIndex Int
  costFen        Int
  runnerId       String?
  leaseUntil     DateTime?
  error          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  finishedAt     DateTime?

  user  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ModelFaceGenerationItem[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([status, leaseUntil])
}

model ModelFaceGenerationItem {
  id            String                 @id @default(cuid())
  jobId         String
  position      Int
  specIndex     Int
  status        ModelFaceItemStatus    @default(pending)
  billingKey    String                 @unique @default(cuid())
  billingStatus ModelFaceBillingStatus @default(uncharged)
  attemptedAt   DateTime?
  faceId        String?                @unique
  error         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  job  ModelFaceGenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  face ModelFace?             @relation(fields: [faceId], references: [id], onDelete: SetNull)

  @@unique([jobId, position])
  @@index([jobId, status])
  @@index([billingStatus])
  @@index([attemptedAt])
  @@index([createdAt])
}
